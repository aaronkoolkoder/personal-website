---
import Base from '../layouts/Base.astro';
import DetailDial from '../components/DetailDial.astro';

const projects = [
  {
    name: 'Diorama',
    href: 'https://github.com/aaronkoolkoder/wallpaperapp',
    blurb: 'live wallpapers for macOS, with Wallpaper Engine scenes rendered natively in Metal',
  },
  {
    name: 'Table',
    blurb: 'poker and blackjack with friends, on iOS',
  },
  {
    name: 'Signal',
    blurb: 'a daily AI brief built from the sources you actually read',
  },
  {
    name: 'Extrovert AI',
    href: 'https://github.com/aaronkoolkoder/Extrovert-AI',
    blurb: 'practice hard conversations with AI personas, built at RythmHacks',
  },
];

const links = [
  { label: 'GitHub', href: 'https://github.com/aaronkoolkoder' },
  // TODO: add email / LinkedIn / resume
];
---

<Base title="Aaron Merchant" description="Aaron Merchant builds software.">
  <main>
    <h1>Aaron Merchant</h1>

    <DetailDial />

    <section>
      <h2>Things I've made</h2>
      <ul class="projects">
        {
          projects.map((p) => (
            <li>
              {p.href ? <a href={p.href}>{p.name}</a> : <span>{p.name}</span>}
              <span class="blurb">{p.blurb}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <footer>
      <nav class="links">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <!-- TODO: Waterloo webring widget goes here once you're added -->
    </footer>
  </main>
</Base>

<style>
  main {
    max-width: 560px;
    margin: 0 auto;
    padding: clamp(64px, 14vh, 140px) 16px 64px;
  }

  h1 {
    font-family: Newsreader, Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: 28px;
    letter-spacing: -0.01em;
    margin: 0 0 20px;
  }

  h2 {
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    margin: 56px 0 12px;
  }

  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .projects li {
    display: flex;
    gap: 12px;
    padding: 8px 0;
    border-top: 1px solid var(--line);
  }

  .projects li > :first-child {
    flex: 0 0 110px;
    font-weight: 500;
  }

  .blurb {
    color: var(--muted);
  }

  @media (max-width: 480px) {
    .projects li {
      flex-direction: column;
      gap: 0;
    }
    .projects li > :first-child {
      flex-basis: auto;
    }
  }

  footer {
    margin-top: 56px;
  }

  .links {
    display: flex;
    gap: 20px;
    font-size: 14px;
  }
</style>
